# Copiez ce fichier vers .env
# Adresse de l'API backend (le projet restaurant-backend), vue depuis le conteneur Nginx.
#  - backend sur la même machine : http://host.docker.internal:8080
#  - backend sur une autre machine : http://192.168.1.20:8080
BACKEND_URL=http://host.docker.internal:8080
# Devise affichée (code ISO 4217) : MGA (Ariary, affiché « Ar »), EUR, XOF...
CURRENCY=MGA
# Port d'accès depuis le réseau local
APP_PORT=80
